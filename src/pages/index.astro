---
import Layout from "../layouts/Layout.astro";

const base = import.meta.env.BASE_URL.replace(/\/$/, "");

const services = [
  { id: "consult", name: "Консультація", desc: "30 хв зі спеціалістом", price: 800 },
  { id: "audio", name: "Аудіометрія", desc: "Перевірка порогів слуху", price: 1200 },
  { id: "tymp", name: "Тимпанометрія", desc: "Стан барабанної перетинки", price: 900 },
];
const devices = [
  { id: "day", name: "Апарат «День»", desc: "Для розмови й вулиці", price: 18900 },
  { id: "plus", name: "Апарат «Плюс»", desc: "Шум, робота, транспорт", price: 27400 },
  { id: "pro", name: "Апарат «Про»", desc: "Преміум, Bluetooth", price: 41200 },
];
---

<Layout>
  <header class="sticky top-0 z-20 border-b border-line bg-paper/95">
    <div class="mx-auto flex max-w-5xl items-center justify-between gap-4 px-5 py-3">
      <a href={`${base}/`} class="flex items-center gap-2 text-lg font-semibold tracking-tight">
        <span class="grid h-8 w-8 place-items-center rounded-lg bg-leaf text-xs text-white">Ч</span>
        Чути
      </a>
      <nav class="hidden items-center gap-6 text-sm text-muted md:flex">
        <a class="hover:text-ink" href="#benefits">Переваги</a>
        <a class="hover:text-ink" href="#calc">Калькулятор</a>
        <a class="hover:text-ink" href="#doctor">Лікар</a>
        <a class="hover:text-ink" href="#book">Запис</a>
      </nav>
      <a href="#book" class="rounded-full bg-leaf px-4 py-2 text-sm font-semibold text-white hover:bg-leaf-2">Записатись</a>
    </div>
  </header>

  <main>
    <section class="mx-auto grid max-w-5xl items-center gap-10 px-5 py-12 md:grid-cols-2 md:py-16">
      <div>
        <p class="text-xs font-semibold uppercase tracking-[0.16em] text-leaf">Київ · демо-лендінг · не клініка</p>
        <h1 class="mt-3 max-w-lg text-4xl font-semibold leading-[1.1] tracking-tight md:text-5xl">
          Слух перевіряємо. Апарат ставимо. Послуги тоді — 0 грн.
        </h1>
        <p class="mt-4 max-w-md text-base leading-relaxed text-muted">
          Обери обстеження і модель у калькуляторі. Якщо в рахунку є апарат, консультація й аналізи обнуляються.
        </p>
        <div class="mt-7 flex flex-wrap gap-3">
          <a href="#calc" class="rounded-full bg-leaf px-5 py-3 text-sm font-semibold text-white hover:bg-leaf-2">Порахувати візит</a>
          <a href="#book" class="rounded-full border border-line bg-white px-5 py-3 text-sm font-semibold hover:border-ink">Залишити телефон</a>
        </div>
        <dl class="mt-8 grid max-w-md grid-cols-3 gap-3 text-center">
          <div class="rounded-2xl border border-line bg-white px-2 py-3">
            <dt class="text-xs text-muted">Слот</dt>
            <dd class="mt-1 text-sm font-semibold">45 хв</dd>
          </div>
          <div class="rounded-2xl border border-line bg-white px-2 py-3">
            <dt class="text-xs text-muted">Графік</dt>
            <dd class="mt-1 text-sm font-semibold">9–18</dd>
          </div>
          <div class="rounded-2xl border border-line bg-white px-2 py-3">
            <dt class="text-xs text-muted">Мова</dt>
            <dd class="mt-1 text-sm font-semibold">українська</dd>
          </div>
        </dl>
      </div>
      <div class="hero-art relative overflow-hidden p-8 text-white">
        <p class="text-xs font-semibold uppercase tracking-[0.16em] text-white/70">Приклад рахунку</p>
        <p class="mt-3 text-3xl font-semibold">Послуги 0 грн</p>
        <p class="mt-1 text-sm text-white/75">бо в розрахунку стоїть апарат</p>
        <ul class="mt-8 space-y-3 text-sm">
          <li class="flex justify-between border-b border-white/15 pb-2"><span>Консультація</span><span>0 грн</span></li>
          <li class="flex justify-between border-b border-white/15 pb-2"><span>Аудіометрія</span><span>0 грн</span></li>
          <li class="flex justify-between"><span>Апарат «День»</span><span>18 900 грн</span></li>
        </ul>
      </div>
    </section>

    <section id="benefits" class="border-y border-line bg-white">
      <div class="mx-auto grid max-w-5xl gap-4 px-5 py-12 sm:grid-cols-3">
        <article class="rounded-2xl border border-line bg-paper p-5">
          <p class="text-sm font-semibold">Один візит</p>
          <p class="mt-2 text-sm leading-relaxed text-muted">Перевірка, підбір і розрахунок на одній сторінці — без «напишіть у директ».</p>
        </article>
        <article class="rounded-2xl border border-line bg-paper p-5">
          <p class="text-sm font-semibold">Знижка в калькуляторі</p>
          <p class="mt-2 text-sm leading-relaxed text-muted">Апарат у рахунку → послуги автоматично 0 грн. Логіка як у рекламному ТЗ.</p>
        </article>
        <article class="rounded-2xl border border-line bg-paper p-5">
          <p class="text-sm font-semibold">Швидка сторінка</p>
          <p class="mt-2 text-sm leading-relaxed text-muted">Astro, без важких фото й зайвого JS — під оцінку PageSpeed.</p>
        </article>
      </div>
    </section>

    <section id="calc" class="mx-auto max-w-5xl px-5 py-16">
      <p class="text-xs font-semibold uppercase tracking-[0.16em] text-leaf">Калькулятор</p>
      <h2 class="mt-2 max-w-xl text-3xl font-semibold tracking-tight">Склади візит. Апарат обнуляє послуги.</h2>
      <p class="mt-3 max-w-xl text-muted">Натисни картки. Можна кілька обстежень і одну модель апарата.</p>

      <div class="mt-10 grid gap-8 lg:grid-cols-[1fr_260px]">
        <div>
          <h3 class="text-sm font-semibold">Послуги</h3>
          <div class="mt-3 grid gap-3 sm:grid-cols-3">
            {services.map((s) => (
              <button type="button" class="pick" data-group="service" data-id={s.id} data-price={s.price}>
                <span class="font-semibold">{s.name}</span>
                <span class="text-sm text-muted">{s.desc}</span>
                <span class="text-sm font-semibold text-leaf">{s.price.toLocaleString("uk-UA")} грн</span>
              </button>
            ))}
          </div>
          <h3 class="mt-8 text-sm font-semibold">Слуховий апарат</h3>
          <div class="mt-3 grid gap-3 sm:grid-cols-3">
            {devices.map((d) => (
              <button type="button" class="pick" data-group="device" data-id={d.id} data-price={d.price}>
                <span class="font-semibold">{d.name}</span>
                <span class="text-sm text-muted">{d.desc}</span>
                <span class="text-sm font-semibold text-leaf">{d.price.toLocaleString("uk-UA")} грн</span>
              </button>
            ))}
          </div>
        </div>
        <aside class="h-fit rounded-2xl border border-line bg-white p-5 shadow-[0_12px_32px_rgba(18,36,28,0.06)] lg:sticky lg:top-20">
          <p class="text-sm text-muted">Разом</p>
          <p id="sum" class="mt-1 text-3xl font-semibold">0 грн</p>
          <p id="note" class="mt-2 text-sm text-leaf">Обери послугу або апарат</p>
          <a href="#book" class="mt-5 block rounded-full bg-leaf py-3 text-center text-sm font-semibold text-white hover:bg-leaf-2">Записатись з цим розрахунком</a>
        </aside>
      </div>
    </section>

    <section id="doctor" class="border-t border-line bg-white">
      <div class="mx-auto grid max-w-5xl items-center gap-10 px-5 py-16 md:grid-cols-2">
        <div class="grid h-64 place-items-center rounded-3xl bg-paper text-leaf">
          <div class="text-center">
            <div class="mx-auto grid h-24 w-24 place-items-center rounded-full bg-leaf text-3xl font-semibold text-white">ІП</div>
            <p class="mt-4 text-sm font-semibold text-ink">Ірина Петренко</p>
            <p class="text-sm text-muted">сурдолог · вигаданий персонаж</p>
          </div>
        </div>
        <div>
          <p class="text-xs font-semibold uppercase tracking-[0.16em] text-leaf">Фахівець</p>
          <h2 class="mt-2 text-3xl font-semibold tracking-tight">Підбір апарата після перевірки, не «з вітрини»</h2>
          <ul class="mt-5 space-y-2 text-sm text-muted">
            <li>— консультація і пороги слуху в одному візиті</li>
            <li>— пояснення, навіщо модель, не лише ціна</li>
            <li>— на проді тут було б посилання в сервіс запису клініки</li>
          </ul>
        </div>
      </div>
    </section>

    <section id="book" class="border-t border-line">
      <div class="mx-auto grid max-w-5xl gap-10 px-5 py-16 md:grid-cols-2">
        <div>
          <h2 class="text-3xl font-semibold tracking-tight">Запис на перевірку</h2>
          <p class="mt-3 text-muted">Демо: форма нікуди не пише. На бойовому сайті — Telegram, CRM або віджет Binotel.</p>
          <p class="mt-6 text-sm">
            Тел. <span class="font-semibold">+380 00 000 00 00</span><br />
            Пн–Пт 9:00–18:00 · Київ
          </p>
        </div>
        <form id="form" class="grid gap-4 rounded-3xl border border-line bg-white p-6">
          <label class="grid gap-1 text-sm font-medium">
            Ім’я
            <input required name="name" class="rounded-xl border border-line bg-paper px-3 py-3 font-normal" />
          </label>
          <label class="grid gap-1 text-sm font-medium">
            Телефон
            <input required name="phone" type="tel" placeholder="+380" class="rounded-xl border border-line bg-paper px-3 py-3 font-normal" />
          </label>
          <label class="flex items-start gap-2 text-sm font-normal text-muted">
            <input required type="checkbox" class="mt-1" />
            Згоден на обробку персональних даних.
          </label>
          <button class="rounded-full bg-leaf py-3 text-sm font-semibold text-white hover:bg-leaf-2" type="submit">Надіслати</button>
          <p id="formOk" class="hidden text-sm text-leaf">Дякую. У демо заявка не відправляється.</p>
        </form>
      </div>
    </section>
  </main>

  <footer class="border-t border-line bg-white">
    <div class="mx-auto max-w-5xl px-5 py-10 text-sm text-muted">
      <p>
        Реклама. Навчальний лендінг, не заклад охорони здоров’я. Не є офертою і не замінює консультацію лікаря.
        Цифри в калькуляторі — приклад логіки знижки.
      </p>
      <p class="mt-4">Чути · демо для портфоліо · Astro + Tailwind</p>
    </div>
  </footer>

  <script is:inline>
    function money(n) {
      return n.toLocaleString("uk-UA") + " грн";
    }

    function total() {
      const services = [...document.querySelectorAll('[data-group="service"].is-on')];
      const device = document.querySelector('[data-group="device"].is-on');
      const serviceSum = services.reduce((a, el) => a + Number(el.dataset.price), 0);
      const deviceSum = device ? Number(device.dataset.price) : 0;
      const hasDevice = Boolean(device);
      document.getElementById("sum").textContent = money((hasDevice ? 0 : serviceSum) + deviceSum);
      document.getElementById("note").textContent = hasDevice
        ? "Послуги = 0 грн, бо обрано апарат"
        : "Додай апарат — послуги стануть 0 грн";
    }

    document.addEventListener("click", (e) => {
      const btn = e.target.closest(".pick");
      if (!btn) return;
      if (btn.dataset.group === "device") {
        document.querySelectorAll('[data-group="device"]').forEach((el) => {
          if (el !== btn) el.classList.remove("is-on");
        });
      }
      btn.classList.toggle("is-on");
      total();
    });

    document.getElementById("form").addEventListener("submit", (e) => {
      e.preventDefault();
      document.getElementById("formOk").classList.remove("hidden");
    });

    total();
  </script>
</Layout>
