---
import Layout from "../layouts/Layout.astro";

const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const services = [
  { id: "consult", name: "Консультація", desc: "30 хв зі спеціалістом", price: 800, on: true },
  { id: "audio", name: "Аудіометрія", desc: "Перевірка порогів слуху", price: 1200, on: true },
  { id: "tymp", name: "Тимпанометрія", desc: "Барабанна перетинка", price: 900, on: false },
];
const devices = [
  { id: "day", name: "Апарат «День»", desc: "Розмова і вулиця", price: 18900, on: true },
  { id: "plus", name: "Апарат «Плюс»", desc: "Шум і транспорт", price: 27400, on: false },
  { id: "pro", name: "Апарат «Про»", desc: "Bluetooth, преміум", price: 41200, on: false },
];
---

<Layout>
  <header class="top">
    <div class="wrap top-in">
      <a class="logo" href={`${base}/`}>Чути<span>кабінет слуху</span></a>
      <nav class="nav">
        <a href="#how">Як це працює</a>
        <a href="#calc">Калькулятор</a>
        <a href="#doctor">Лікар</a>
        <a href="#book">Запис</a>
      </nav>
      <a class="btn" href="#book">Записатись</a>
    </div>
  </header>

  <main>
    <section class="hero">
      <div class="wrap hero-grid">
        <div>
          <p class="kicker">Київ · перевірка слуху</p>
          <h1>Почуєте знову. Обстеження — у подарунок до апарата.</h1>
          <p class="lede">
            Оберіть послуги і модель. Якщо в рахунку є слуховий апарат,
            консультація й аналізи стають 0 грн — сума рахується одразу.
          </p>
          <div class="hero-acts">
            <a class="btn" href="#calc">Порахувати візит</a>
            <a class="btn btn-ghost" href="#book">Залишити телефон</a>
          </div>
          <p class="meta">
            <span><b>45 хв</b> візит</span>
            <span><b>9:00–18:00</b> будні</span>
            <span><b>українською</b></span>
          </p>
        </div>
        <aside class="chart" aria-hidden="true">
          <div class="chart-top"><span>Аудіограма · приклад</span><span>Hz</span></div>
          <svg viewBox="0 0 440 240" xmlns="http://www.w3.org/2000/svg">
            <g stroke="#2e3330" stroke-width="1">
              <path d="M48 16h372M48 56h372M48 96h372M48 136h372M48 176h372" />
              <path d="M80 16v160M140 16v160M200 16v160M260 16v160M320 16v160M380 16v160" />
            </g>
            <path fill="none" stroke="#c4a574" stroke-width="1.75" d="M80 44 L140 58 L200 74 L260 66 L320 92 L380 84" />
            <g fill="#ebe4d4">
              <circle cx="80" cy="44" r="3.5" />
              <circle cx="140" cy="58" r="3.5" />
              <circle cx="200" cy="74" r="3.5" />
              <circle cx="260" cy="66" r="3.5" />
              <circle cx="320" cy="92" r="3.5" />
              <circle cx="380" cy="84" r="3.5" />
            </g>
            <g fill="#7a756c" font-size="10" font-family="IBM Plex Sans, sans-serif">
              <text x="8" y="20">0</text>
              <text x="8" y="60">20</text>
              <text x="8" y="100">40</text>
              <text x="8" y="140">60</text>
              <text x="8" y="180">dB</text>
              <text x="72" y="208">250</text>
              <text x="128" y="208">500</text>
              <text x="190" y="208">1k</text>
              <text x="248" y="208">2k</text>
              <text x="308" y="208">4k</text>
              <text x="368" y="208">8k</text>
            </g>
          </svg>
          <div class="chart-sum">
            <span>Разом з апаратом «День»</span>
            <strong>18 900 грн</strong>
          </div>
        </aside>
      </div>
    </section>

    <section class="band-how" id="how">
      <div class="wrap strip">
        <article>
          <span class="n">01</span>
          <b>Перевірка</b>
          <p>Консультація, аудіометрія, тимпанометрія — відмічаєте в калькуляторі.</p>
        </article>
        <article>
          <span class="n">02</span>
          <b>Апарат</b>
          <p>Одна модель. Послуги в сумі одразу стають нулем — акція на екрані.</p>
        </article>
        <article>
          <span class="n">03</span>
          <b>Запис</b>
          <p>Телефон у формі. Передзвонимо, узгодимо час, скажемо що взяти з собою.</p>
        </article>
      </div>
    </section>

    <section class="wrap block" id="calc">
      <p class="kicker">Калькулятор</p>
      <h2>Складіть візит. Апарат закриває послуги.</h2>
      <p class="lede lede-ink">Кілька обстежень і одна модель. Без апарата послуги за прайсом.</p>
      <div class="calc has-device">
        <div>
          <p class="group-title"><span>Послуги</span><span>грн</span></p>
          <div class="picks">
            {services.map((s) => (
              <button type="button" class:list={["pick", s.on && "is-on"]} data-group="service" data-id={s.id} data-price={s.price}>
                <span class="box"></span>
                <span class="name"><b>{s.name}</b><span>{s.desc}</span></span>
                <span class="price">
                  <span class="price-was">{s.price.toLocaleString("uk-UA")}</span>
                  <span class="price-now">0</span>
                </span>
              </button>
            ))}
          </div>
          <p class="group-title" style="margin-top:36px"><span>Слуховий апарат</span><span>грн</span></p>
          <div class="picks">
            {devices.map((d) => (
              <button type="button" class:list={["pick", d.on && "is-on"]} data-group="device" data-id={d.id} data-price={d.price}>
                <span class="box"></span>
                <span class="name"><b>{d.name}</b><span>{d.desc}</span></span>
                <span class="price">{d.price.toLocaleString("uk-UA")}</span>
              </button>
            ))}
          </div>
        </div>
        <aside class="total">
          <p class="kicker">Разом</p>
          <strong id="sum">18 900 грн</strong>
          <p id="note">Послуги = 0 грн, бо обрано апарат</p>
          <a class="btn" href="#book">Записатись з цим розрахунком</a>
        </aside>
      </div>
    </section>

    <section class="wrap block" id="doctor" style="padding-top:0">
      <p class="kicker">Фахівець</p>
      <div class="split">
        <div class="quote-xl">
          <p>«Підбір після перевірки, не з вітрини. Спочатку пороги слуху і побут — потім модель.»</p>
          <p class="who"><b>Ірина Петренко</b> сурдолог, прийом у Києві</p>
        </div>
        <ul class="ticks">
          <li>Пороги слуху і розмова про побут в одному візиті</li>
          <li>Пояснення моделі: навіщо вона, не лише скільки коштує</li>
          <li>Налаштування після видачі — без «забрали й забули»</li>
        </ul>
      </div>
    </section>

    <section class="wrap block" style="padding-top:0">
      <p class="kicker">Відгук</p>
      <div class="quote-xl">
        <p>«На кухні знову чую чайник і онука з коридору. Підібрали не найдорожче, а те, що сіло.»</p>
        <p class="who"><b>Олена, 67</b> після першого тижня з апаратом</p>
      </div>
    </section>

    <section class="wrap block" style="padding-top:0">
      <p class="kicker">Питання</p>
      <h2>Перед записом</h2>
      <div class="faq">
        <details open>
          <summary>Чи треба направлення?</summary>
          <p>Ні. Якщо вже є аудіограма до року — візьміть із собою, повторимо за потреби.</p>
        </details>
        <details>
          <summary>Чому послуги стають нулем?</summary>
          <p>Акція лендінгу: обрали апарат у розрахунку — діагностика в подарунок. Без апарата послуги за прайсом.</p>
        </details>
        <details>
          <summary>Скільки триває візит?</summary>
          <p>Близько 45 хвилин: розмова, перевірка, примірка. Апарат після налаштування, не з полиці.</p>
        </details>
      </div>
    </section>

    <section class="book-band" id="book">
      <div class="wrap block book">
        <div>
          <p class="kicker">Запис</p>
          <h2>Залиште телефон — передзвонимо за 15 хвилин</h2>
          <p class="lede">Узгодимо день і скажемо, чи брати наявну аудіограму.</p>
          <p class="hours">
            <b>Пн–Пт 9:00–18:00 · сб 10:00–14:00</b>
            Київ, кабінет на Подолі
          </p>
        </div>
        <form class="form" id="form">
          <label>Ім’я<input required name="name" type="text" autocomplete="name" /></label>
          <label>Телефон<input required name="phone" type="tel" placeholder="+380" autocomplete="tel" /></label>
          <label class="check">
            <input required type="checkbox" />
            Згоден на обробку персональних даних для запису на прийом.
          </label>
          <button class="btn" type="submit">Надіслати заявку</button>
          <p id="formOk" hidden style="margin:0;color:var(--copper)">Дякую. Передзвонимо в робочі години.</p>
        </form>
      </div>
    </section>
  </main>

  <footer class="foot">
    <div class="wrap foot-in">
      <p>
        Реклама. Навчальний лендінг «Чути», не заклад охорони здоров’я. Не є офертою
        і не замінює консультацію лікаря. Цифри в калькуляторі — приклад логіки знижки.
      </p>
      <p>Чути · Київ</p>
    </div>
  </footer>
  <div class="bar-mob"><a class="btn" href="#book">Записатись</a></div>

  <script is:inline>
    function money(n) {
      return n.toLocaleString("uk-UA") + " грн";
    }
    function total() {
      const root = document.querySelector(".calc");
      const services = [...document.querySelectorAll('[data-group="service"].is-on')];
      const device = document.querySelector('[data-group="device"].is-on');
      const serviceSum = services.reduce((a, el) => a + Number(el.dataset.price), 0);
      const deviceSum = device ? Number(device.dataset.price) : 0;
      const hasDevice = Boolean(device);
      root.classList.toggle("has-device", hasDevice);
      document.getElementById("sum").textContent = money((hasDevice ? 0 : serviceSum) + deviceSum);
      document.getElementById("note").textContent = hasDevice
        ? "Послуги = 0 грн, бо обрано апарат"
        : "Додайте апарат — послуги стануть 0 грн";
    }
    document.addEventListener("click", (e) => {
      const btn = e.target.closest(".pick");
      if (!btn) return;
      if (btn.dataset.group === "device") {
        document.querySelectorAll('[data-group="device"]').forEach((el) => {
          if (el !== btn) el.classList.remove("is-on");
        });
      }
      btn.classList.toggle("is-on");
      total();
    });
    document.getElementById("form").addEventListener("submit", (e) => {
      e.preventDefault();
      document.getElementById("formOk").hidden = false;
    });
    total();
  </script>
</Layout>
