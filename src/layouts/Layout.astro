---
import "../styles/global.css";

const base = import.meta.env.BASE_URL;
---
<!DOCTYPE html>
<html lang="uk">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Чути — кабінет слуху · демо лендінг</title>
    <meta
      name="description"
      content="Демо швидкого лендінгу: калькулятор, запис, дисклеймер. Не медична клініка."
    />
    <link rel="icon" href={`${base}favicon.svg`} type="image/svg+xml" />
  </head>
  <body class="antialiased">
    <slot />
  </body>
</html>
